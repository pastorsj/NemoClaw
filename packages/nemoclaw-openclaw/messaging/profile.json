        "secretMaterialKeys": ["private_key"]
      }
    },
    "config": {
      "visibility": [
        {
          "inputId": "audienceType",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "googlechat", "audienceType"]
        },
        {
          "inputId": "audience",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "googlechat", "audience"]
        },
        {
          "inputId": "appPrincipal",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "googlechat", "appPrincipal"]
        },
        {
          "inputId": "allowFrom",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "googlechat", "dm", "allowFrom"]
        }
      ],
      "renders": [
        {
          "id": "googlechat-openclaw-channel",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "channels.googlechat",
          "value": {
            "enabled": true,
            "serviceAccountFile": "/nonexistent/googlechat-gateway-minted-no-service-account-file",
            "audienceType": "{{googlechatConfig.audienceType}}",
            "audience": "{{googlechatConfig.audience}}",
            "appPrincipal": "{{googlechatConfig.appPrincipal}}",
            "webhookPath": "/googlechat",
            "healthMonitor": { "enabled": false },
            "dm": {
              "policy": "{{allowedIds.googlechat.dmPolicy}}",
              "allowFrom": "{{allowedIds.googlechat.values}}"
            }
          }
        },
        {
          "id": "googlechat-openclaw-plugin",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "plugins.entries.googlechat",
          "value": { "enabled": true }
        },
        {
          "id": "googlechat-openclaw-gateway-reload-off",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "gateway.reload",
          "value": { "mode": "off" }
        }
      ]
    },
    "policy": [{ "presetName": "googlechat", "policyKeys": ["googlechat"] }],
    "lifecycle": {
      "runtime": {
        "channelName": "googlechat",
        "visibility": { "configKeys": ["googlechat"], "logPatterns": ["googlechat"] },
        "nodePreloads": [
          {
            "module": "googlechat-trusted-proxy-fetch",
            "injectInto": ["boot"],
            "optional": false,
            "installMessage": "[channels] Installing Google Chat trusted-proxy-fetch patch (route googleapis via trusted env proxy)",
            "installedMessage": "[channels] Google Chat trusted-proxy-fetch patch installed (NODE_OPTIONS updated)"
          },
          {
            "module": "googlechat-outbound-auth",
            "injectInto": ["boot"],
            "optional": false,
            "installMessage": "[channels] Installing Google Chat outbound-auth patch (gateway-minted bearer)",
            "installedMessage": "[channels] Google Chat outbound-auth patch installed (NODE_OPTIONS updated)"
          }
        ],
        "secretScans": [
          {
            "path": "/sandbox/.openclaw/openclaw.json",
            "pattern": "-----BEGIN (?:RSA )?PRIVATE KEY-----",
            "message": "[SECURITY] Google Chat service account private key leaked into {path} - refusing to serve",
            "exitCode": 78
          }
        ]
      },
      "packageInstalls": [
        {
          "id": "openclawPluginPackage",
          "manager": "node-package",
