          },
          "tarballUrlByVersion": {
            "2026.7.1": "https://registry.npmjs.org/@openclaw/googlechat/-/googlechat-2026.7.1.tgz"
          },
          "required": true
        }
      ],
      "hookIds": [
        "googlechat-tunnel-audience-gate",
        "googlechat-service-account",
        "googlechat-config-prompt"
      ],
      "hookOperations": [
