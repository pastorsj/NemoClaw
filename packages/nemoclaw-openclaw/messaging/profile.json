[
  {
    "channelId": "telegram",
    "config": {
      "visibility": [
        {
          "inputId": "allowedIds",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "telegram", "accounts", "default", "allowFrom"]
        },
        {
          "inputId": "groupPolicy",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "telegram", "accounts", "default", "groupPolicy"]
        },
        {
          "key": "groupRequireMention",
          "inputId": "requireMention",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "telegram", "groups"],
          "whenInput": { "inputId": "groupPolicy", "equals": "open", "defaultValue": "open" }
        }
      ],
      "renders": [
        {
          "id": "telegram-openclaw-channel",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "channels.telegram",
          "value": {
            "enabled": true,
            "accounts": {
              "default": {
                "enabled": true,
                "healthMonitor": { "enabled": false },
                "proxy": "{{proxyUrl}}",
                "groupPolicy": "{{telegramConfig.groupPolicy}}",
                "dmPolicy": "{{allowedIds.telegram.dmPolicy}}",
                "allowFrom": "{{allowedIds.telegram.values}}"
              }
            }
          }
        },
        {
          "id": "telegram-openclaw-groups",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "when": "{{telegramConfig.openclawGroups}}",
          "path": "channels.telegram.groups",
          "value": "{{telegramConfig.openclawGroups}}"
        },
        {
          "id": "telegram-openclaw-plugin",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "plugins.entries.telegram",
          "value": { "enabled": true }
        }
      ]
    },
    "policy": [
      { "presetName": "telegram", "policyKeys": ["telegram_bot"], "requiredAtCreate": true }
    ],
    "lifecycle": {
      "runtime": {
        "channelName": "telegram",
        "visibility": { "configKeys": ["telegram"], "logPatterns": ["telegram"] },
        "nodePreloads": [
          {
            "module": "telegram-diagnostics",
            "injectInto": ["boot", "connect"],
            "optional": false,
            "installMessage": "[channels] Installing Telegram diagnostics (provider readiness + inference errors)",
            "installedMessage": "[channels] Telegram diagnostics installed (NODE_OPTIONS updated)"
          }
        ]
      },
      "hookIds": [
        "telegram-token-paste",
        "telegram-allowlist-aliases",
        "telegram-config-prompt",
        "telegram-get-me-reachability",
        "telegram-openclaw-bridge-health",
        "telegram-gateway-conflict-status",
        "telegram-status-health"
      ],
      "hookOperations": [
        {
          "hookId": "telegram-config-prompt",
          "kind": "config-prompt",
          "outputIds": ["requireMention", "allowedIds", "groupPolicy"]
        },
        {
          "hookId": "telegram-openclaw-bridge-health",
          "kind": "sandbox-command",
          "command": {
            "argv": [
              "node",
              "--experimental-strip-types",
              "--no-warnings",
              "/usr/local/lib/nemoclaw/messaging-probe.mts",
              "bridge-health",
              "telegram"
            ]
          },
          "output": "bridge-health"
        },
        {
          "hookId": "telegram-status-health",
          "kind": "sandbox-command",
          "command": {
            "argv": [
              "node",
              "--experimental-strip-types",
              "--no-warnings",
              "/usr/local/lib/nemoclaw/messaging-probe.mts",
              "telegram-status"
            ]
          },
          "output": "channel-health",
          "context": "channel-health"
        }
      ]
    }
  },
  {
    "channelId": "discord",
    "config": {
      "visibility": [
        {
          "key": "guildIds",
          "inputId": "serverId",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "discord", "guilds"]
        },
        {
          "key": "guildRequireMention",
          "inputId": "requireMention",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "discord", "guilds"]
        },
        {
          "key": "guildUsers",
          "inputId": "userId",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "discord", "guilds"]
        }
      ],
      "renders": [
        {
          "id": "discord-openclaw-channel",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "channels.discord",
          "value": {
            "enabled": true,
            "accounts": {
              "default": {
                "enabled": true,
                "healthMonitor": { "enabled": false },
                "proxy": "{{discordProxyUrl}}",
                "dmPolicy": "{{discord.allowedUsers.dmPolicy}}",
                "allowFrom": "{{discord.allowedUsers.values}}"
              }
            }
          }
        },
        {
          "id": "discord-openclaw-guilds",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "when": "{{discord.hasGuilds}}",
          "path": "channels.discord",
          "value": { "groupPolicy": "allowlist", "guilds": "{{discord.guilds}}" }
        },
        {
          "id": "discord-openclaw-plugin",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "plugins.entries.discord",
          "value": { "enabled": true }
        }
      ]
    },
    "policy": [
      {
        "presetName": "discord",
        "policyKeys": ["discord"],
        "requiredAtCreate": true,
        "validationWarningLines": [
          "OpenClaw validation uses its Node runtime:",
          "node -e \"require('node:https').get('https://discord.com/api/v10/gateway',r=>console.log(r.statusCode)).on('error',e=>{console.error(e.message);process.exitCode=1})\""
        ]
      }
    ],
    "lifecycle": {
      "runtime": {
        "channelName": "discord",
        "visibility": { "configKeys": ["discord"], "logPatterns": ["discord"] }
      },
      "packageInstalls": [
        {
          "id": "openclawPluginPackage",
          "manager": "node-package",
          "spec": "npm:@openclaw/discord@{{package.version}}",
          "pin": true,
          "integrityByVersion": {
            "2026.7.1": "sha512-tZfdC1YA8oVLvc2BK1w0F6rUljS5ugCOp2uWe0vPsbG1fbzVVIO4V32RoqZznGHe5u2R9u4n1aV5Z/qa1m2oFg=="
          },
          "tarballUrlByVersion": {
            "2026.7.1": "https://registry.npmjs.org/@openclaw/discord/-/discord-2026.7.1.tgz"
          },
          "required": true
        }
      ],
      "hookIds": ["discord-openclaw-bridge-health", "discord-token-paste", "discord-config-prompt"],
      "hookOperations": [
        {
          "hookId": "discord-openclaw-bridge-health",
          "kind": "sandbox-command",
          "command": {
            "argv": [
              "node",
              "--experimental-strip-types",
              "--no-warnings",
              "/usr/local/lib/nemoclaw/messaging-probe.mts",
              "bridge-health",
              "discord"
            ]
          },
          "output": "bridge-health"
        }
      ]
    }
  },
  {
    "channelId": "wechat",
    "config": {
      "visibility": [
        {
          "key": "accountIds",
          "inputId": "accountId",
          "target": "openclaw.json",
          "kind": "structured",
          "path": ["channels", "openclaw-weixin", "accounts"]
        },
        {
          "inputId": "baseUrl",
          "target": "~/.openclaw/openclaw-weixin/accounts/{{input}}.json",
          "targetInputId": "accountId",
          "kind": "structured",
          "path": ["baseUrl"]
        },
        {
          "inputId": "userId",
          "target": "~/.openclaw/openclaw-weixin/accounts/{{input}}.json",
          "targetInputId": "accountId",
          "kind": "structured",
          "path": ["userId"]
        }
      ],
      "renders": [
        {
          "id": "wechat-openclaw-plugin",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "plugins.entries.openclaw-weixin",
          "value": { "enabled": true }
        },
        {
          "id": "wechat-openclaw-channel",
          "kind": "json-fragment",
          "target": "~/.openclaw/openclaw.json",
          "path": "channels.openclaw-weixin",
          "value": { "enabled": true }
        }
      ],
      "statePaths": ["wechat", "openclaw-weixin"]
    },
    "policy": [
      { "presetName": "wechat", "policyKeys": ["wechat_bridge"], "requiredAtCreate": true }
    ],
    "lifecycle": {
      "runtime": {
        "channelName": "openclaw-weixin",
        "visibility": {
          "configKeys": ["openclaw-weixin"],
          "logPatterns": ["wechat", "openclaw-weixin"]
        },
        "nodePreloads": [
          { "module": "wechat-account-placeholder", "injectInto": ["boot"], "optional": false },
          {
            "module": "wechat-diagnostics",
            "injectInto": ["boot", "connect"],
            "optional": false,
            "installMessage": "[channels] Installing WeChat diagnostics (provider readiness + inference errors)",
            "installedMessage": "[channels] WeChat diagnostics installed (NODE_OPTIONS updated)"
          }
        ]
      },
      "packageInstalls": [
        {
          "id": "openclawPluginPackage",
          "manager": "node-package",
          "spec": "npm:@tencent-weixin/openclaw-weixin@2.4.3",
          "pin": true,
          "integrity": "sha512-dPQbidUNWigC6V10vGW4i+GLH09x+6zUhafZRjuxkJ9GDu8o62WBsnUTojp4KqUH756hz+t2v9khiCRSi0dBDw==",
          "tarballUrl": "https://registry.npmjs.org/@tencent-weixin/openclaw-weixin/-/openclaw-weixin-2.4.3.tgz",
          "runtimeLock": {
            "cachePath": "/usr/local/share/nemoclaw/wechat-npm-cache",
            "installCacheEnvKey": "NEMOCLAW_WECHAT_NPM_INSTALL_CACHE",
            "lockFile": "/usr/local/lib/nemoclaw/wechat-runtime/package-lock.json",
            "projectsRoot": "/sandbox/.openclaw/npm/projects",
            "verifierPath": "/usr/local/lib/nemoclaw/verify-wechat-runtime-lock.mts",
            "offline": true,
            "legacyPeerDeps": true
          },
          "required": true
        }
      ],
      "hookIds": [
        "wechat-host-qr",
        "wechat-config-prompt",
        "wechat-seed-openclaw-account",
        "wechat-health-check"
      ],
      "hookOperations": [
        {
          "hookId": "wechat-seed-openclaw-account",
          "kind": "build-files",
          "inputIds": [
            "wechatConfig.accountId",
            "wechatConfig.baseUrl",
            "wechatConfig.userId",
            "credential.wechatBotToken.placeholder"
          ],
          "outputs": [
            {
              "id": "openclawWeixinAccountsIndex",
              "pathTemplate": "openclaw-weixin/accounts.json",
              "mode": "0600",
              "content": [{ "$input": "wechatConfig.accountId" }]
            },
            {
              "id": "openclawWeixinAccountFile",
              "pathTemplate": "openclaw-weixin/accounts/{{input:wechatConfig.accountId}}.json",
              "mode": "0600",
              "content": {
                "token": { "$input": "credential.wechatBotToken.placeholder" },
                "savedAt": { "$generated": "iso-timestamp" },
                "baseUrl": { "$input": "wechatConfig.baseUrl", "optional": true },
                "userId": { "$input": "wechatConfig.userId", "optional": true }
              }
            },
            {
              "id": "openclawConfigPatch",
              "pathTemplate": "openclaw.json",
              "merge": {
                "plugins": {
                  "installs": {
                    "openclaw-weixin": {
                      "source": "npm",
                      "spec": "@tencent-weixin/openclaw-weixin@2.4.3",
                      "installPath": "/sandbox/.openclaw/extensions/openclaw-weixin"
                    }
                  },
                  "entries": { "openclaw-weixin": { "enabled": true } }
                },
                "channels": {
                  "openclaw-weixin": {
                    "enabled": true,
                    "channelConfigUpdatedAt": { "$generated": "iso-timestamp" },
                    "accounts": {
                      "{{input:wechatConfig.accountId}}": { "enabled": true }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
