        "slack-openclaw-bridge-health",
        "slack-socket-mode-gateway-status",
        "slack-status-health",
        "slack-token-paste",
        "slack-config-prompt",
        "slack-credential-validation"
      ],
      "hookOperations": [
        {
          "hookId": "slack-openclaw-bridge-health",
          "kind": "sandbox-command",
          "command": {
            "argv": [
              "node",
              "--experimental-strip-types",
              "--no-warnings",
              "/usr/local/lib/nemoclaw/messaging-probe.mts",
              "bridge-health",
              "slack"
            ]
          },
          "output": "bridge-health"
