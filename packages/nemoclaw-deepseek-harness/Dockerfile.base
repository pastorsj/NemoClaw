#
# Local POC base: reviewed system tools plus one hash-locked Python graph.

FROM node:22-trixie-slim@sha256:db8a96a63e5264607ada2d206758876ebbed6a12be2ada7517793cbfb0c2a29c

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/nemoclaw-fabric-venv \
    PATH="/usr/local/bin:/opt/nemoclaw-fabric-venv/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

# Match the terminal-image system boundary used by the existing Python harness.
# The POC intentionally does not declare a managed image until this base has
# completed the repository's dependency and security publication review.
# hadolint ignore=DL4006
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3=3.13.5-1 \
        python3-pip=25.1.1+dfsg-1 \
        python3-venv=3.13.5-1 \
        ca-certificates=20250419 \
        curl=8.14.1-2+deb13u4 \
        git=1:2.47.3-0+deb13u1 \
        iproute2=6.15.0-1 \
        iptables=1.8.11-2 \
        nftables=1.1.3-1 \
        procps=2:4.0.4-9 \
        util-linux=2.41-5 \
        openssh-sftp-server=1:10.0p1-7+deb13u4 \
        ripgrep=14.1.1-1+b4 \
    && rm -rf /var/lib/apt/lists/* \
    && test -z "$(dpkg --audit)"

COPY packages/nemoclaw-deepseek-harness/fabric/requirements.lock /tmp/nemoclaw-deepseek-requirements.lock

RUN python3 -m venv --copies /opt/nemoclaw-fabric-venv \
    && /opt/nemoclaw-fabric-venv/bin/pip3 install --no-cache-dir --require-hashes \
        -r /tmp/nemoclaw-deepseek-requirements.lock \
    && /opt/nemoclaw-fabric-venv/bin/pip3 check \
    && /opt/nemoclaw-fabric-venv/bin/python3 -I -c \
        "from importlib.metadata import version; expected = {'deepseek-harness-sdk': '0.1.2rc1', 'deepseek-harness-runtime-bin': '0.1.2rc1', 'nemo-fabric': '0.2.0', 'nemo-fabric-adapter-contract': '0.2.0', 'nemo-fabric-adapters-common': '0.2.0', 'nemo-fabric-runtime': '0.2.0'}; actual = {name: version(name) for name in expected}; assert actual == expected, actual" \
    && install -d -o root -g root -m 0700 /tmp/nemoclaw-dsh-version \
    && test "$(DSH_HOME=/tmp/nemoclaw-dsh-version /opt/nemoclaw-fabric-venv/bin/dsh --version)" = "0.1.2-rc.1" \
    && rm -f /tmp/nemoclaw-deepseek-requirements.lock

RUN groupadd -r -g 999 sandbox \
    && useradd -r -u 999 -g sandbox -d /sandbox -s /bin/bash sandbox \
    && usermod -a -G sandbox root \
    && install -d -o sandbox -g sandbox -m 0700 \
        /sandbox/.deepseek-harness \
        /sandbox/.deepseek-harness/sessions \
        /sandbox/.deepseek-harness/logs \
        /sandbox/.deepseek-harness/cache \
        /sandbox/.deepseek-harness/fabric-artifacts \
    && install -d -o sandbox -g sandbox -m 0700 /sandbox/.nemoclaw \
    && test "$(id -u sandbox):$(id -g sandbox)" = "999:999"

ENV HOME=/sandbox \
    DSH_HOME=/sandbox/.deepseek-harness \
    DSH_TELEMETRY_MODE=DISABLED \
    DSH_TELEMETRY_DISABLED=1

WORKDIR /sandbox
