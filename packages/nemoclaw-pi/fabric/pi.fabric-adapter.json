{
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.nemoclaw.pi",
  "adapter_kind": "python",
  "runner": {
    "module": "nemoclaw_pi_fabric.adapter"
  },
  "requirements": {
    "binaries": ["pi"]
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": { "const": "openshell" },
      "model": { "type": "string", "minLength": 1 },
      "api_key_env": { "type": "string", "minLength": 1 },
      "base_url": { "const": "https://inference.local/v1" }
    },
    "required": ["provider", "model", "api_key_env", "base_url"],
    "additionalProperties": false
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "instructions.system",
      "tools.enabled",
      "tools.blocked",
      "skills"
    ]
  },
  "capabilities": {
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
